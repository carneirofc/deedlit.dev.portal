# Copy to .env.local for local development.
#
# Two sign-in providers are supported and either may be omitted: GitHub and a
# generic OIDC issuer. A provider is only offered on /login when it is fully
# configured; with neither configured, nobody can sign in.

# Signs the session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required behind a reverse proxy (Traefik in the cluster); harmless locally.
AUTH_TRUST_HOST=true

# Pins the origin used for callbacks and cookie scope. Not optional in a
# deployment — see AGENTS.md. Its scheme also decides the Secure cookie flag.
# AUTH_URL=https://deedlit.dev

# --- GitHub -------------------------------------------------------------
# Register a GitHub OAuth app with the callback URL
#   http://localhost:3001/api/auth/callback/github
# GitHub allows one callback URL per app, so use a separate app from production.

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Who may sign in with GitHub. The check fails closed: if neither of these is
# set, no GitHub account is admitted.

# Only active members of this GitHub organization are admitted.
AUTH_ALLOWED_GITHUB_ORG=

# Optional: narrow to a team within that org (team slug).
AUTH_ALLOWED_GITHUB_TEAM=

# Optional: comma-separated accounts allowed alongside the org check. Useful
# before an org exists. Pin each login to its immutable numeric id — a freed
# login can be re-registered by someone else:
#   login:id   both must match (preferred)
#   id         id only
#   login      legacy, logs a warning
# Get the id with: gh api users/<login> --jq .id
AUTH_ALLOWED_GITHUB_USERS=carneirofc

# --- Generic OIDC -------------------------------------------------------
# Any OpenID Connect compliant issuer (Keycloak, Authentik, Authelia, Zitadel,
# Entra ID, Okta, Google, …). Endpoints come from
#   <issuer>/.well-known/openid-configuration
# so only the issuer is needed. Register the callback URL
#   http://localhost:3001/api/auth/callback/oidc
# Must be https:// unless it points at localhost/127.0.0.1.

AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=

# Optional: label on the sign-in button (default "SSO").
# AUTH_OIDC_NAME=Keycloak

# Optional: override the requested scopes (default "openid profile email").
# Group-based rules usually need an extra scope, e.g. "openid profile email groups".
# AUTH_OIDC_SCOPE=

# Optional: which claim carries the display username (default
# "preferred_username"; falls back to email, then sub).
# AUTH_OIDC_USERNAME_CLAIM=

# Optional: which claim carries group membership (default "groups").
# AUTH_OIDC_GROUPS_CLAIM=

# Who may sign in with OIDC. Any one rule matching admits the account; if none
# of the four is set, no OIDC account is admitted — authenticating at the
# issuer is not by itself authorization to use the portal.

# Comma-separated `sub` claims (stable, opaque per-user ids at the issuer).
AUTH_ALLOWED_OIDC_SUBJECTS=

# Comma-separated email addresses. Only a verified email (email_verified=true)
# can match this or the domain rule below.
AUTH_ALLOWED_OIDC_EMAILS=

# Comma-separated email domains, e.g. "deedlit.dev,example.org".
AUTH_ALLOWED_OIDC_DOMAINS=

# Comma-separated group names, matched case-insensitively against the group
# claim, e.g. "portal-admins" or "/platform/admins".
AUTH_ALLOWED_OIDC_GROUPS=
